# 이 파일을 복사해 이름을 .env 로 바꾼 뒤 값을 채웁니다. (.env 는 절대 커밋하지 않습니다)
#   cp .env.example .env

# 공공데이터포털 > 마이페이지 > 개발계정 > 일반 인증키
# 계정당 키가 하나라 두 칸에 같은 값을 넣으면 됩니다. Encoding·Decoding 어느 쪽을 넣어도 됩니다.
DATA_LAB_KEY=
TOUR_API_KEY=

# SGIS 개발지원센터 > 마이페이지 > 서비스 관리 > Service ID / Secret Key
SGIS_SERVICE_ID=
SGIS_SECRET_KEY=

# Supabase > 프로젝트 > Connect > Session pooler 주소 ([YOUR-PASSWORD] 자리에 DB 비밀번호)
DATABASE_URL=
